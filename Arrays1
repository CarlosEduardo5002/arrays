
import java.util.Random;
import java.util.Scanner;

public class arrays1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Random rn = new Random();
        int qtdLivros = 0, menu;
        int[] titulo, qtdPaginas, anoPublicacao,
              qtdEmprestimos, qtdDevolucao;
        while(qtdLivros < 1000 || qtdLivros > 5000) {
            System.out.println("Digite a quantidade de livros que sera cadastrada: (1000 - 5000)");
            qtdLivros = sc.nextInt();
            if(qtdLivros < 1000 || qtdLivros > 5000) {
                System.out.println("Quantidade de Livros Invalida.");
            }
        }
        titulo = new int[qtdLivros];
        qtdPaginas = new int[qtdLivros];
        anoPublicacao = new int[qtdLivros];
        qtdEmprestimos = new int[qtdLivros];
        qtdDevolucao = new int[qtdLivros];
        for(int i = 0; i < titulo.length; i++) {
            titulo[i] = rn.nextInt(1000, 5000);
            anoPublicacao[i] = rn.nextInt(1950, 2026);
            qtdPaginas[i] = rn.nextInt(50, 1501);
            qtdEmprestimos[i] = rn.nextInt(0, 501);
            qtdDevolucao[i] = rn.nextInt(0, qtdEmprestimos[i] + 1);
        }
        System.out.println("Quantidade de livros aceita: " + qtdLivros);
        do {
            System.out.println("Selecione a Opcao que deseja Acessar:");
            System.out.println("=====================================");
            System.out.println("1 - Listar Livros");
            System.out.println("2 - Livro Mais Emprestado");
            System.out.println("3 - Livro Menos Emprestado");
            System.out.println("4 - Media de Emprestimos");
            System.out.println("5 - Livros Acima da media de emprestimos");
            System.out.println("6 - Estatisticas");
            System.out.println("7 - Buscar Livro Pelo Titulo");
            System.out.println("8 - Encerrar");
            menu = sc.nextInt();
            switch(menu) {
                case 1:
                    for(int i = 0; i < titulo.length; i++) {
                        System.out.println("\nTitulo: " + titulo[i]);
                        System.out.println("Ano de publicacao: " + anoPublicacao[i]);
                        System.out.println("Quantidade de paginas: " + qtdPaginas[i]);
                        System.out.println("Quantidade de emprestimos: " + qtdEmprestimos[i]);
                        System.out.println("Quantidade de devolucoes: " + qtdDevolucao[i]);
                        System.out.println("==============================");
                    }
                    break;
                case 2:
                    System.out.println("Livro Mais Emprestado");
                    break;
                case 3:
                    System.out.println("Livro Menos Emprestado");
                    break;
                case 4:
                    System.out.println("Media de Emprestimos");
                    break;
                case 5:
                    System.out.println("Livros Acima da Media");
                    break;
                case 6:
                    System.out.println("Estatisticas");
                    break;
                case 7:
                    System.out.println("Buscar Livro Pelo Titulo");
                    break;
                case 8:
                    System.out.println("Encerrando o programa...");
                    break;
                default:
                    System.out.println("Opcao invalida!");
                    break;
            }
        } while(menu != 8);

        System.out.println("=== Seja Sempre Bem Vindo ===");
        System.out.println("=============================");
    }
}
